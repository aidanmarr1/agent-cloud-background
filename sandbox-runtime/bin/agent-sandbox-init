#!/usr/bin/env bash
set -euo pipefail

ready_file=/tmp/agent-sandbox-ready
rm -f "$ready_file"
mkdir -p /tmp/agent-supervisor

/usr/bin/supervisord -c /etc/agent/supervisord.conf &
supervisor_pid=$!

shutdown() {
  kill "$supervisor_pid" >/dev/null 2>&1 || true
  wait "$supervisor_pid" || true
  exit 0
}
trap shutdown INT TERM

for _ in $(seq 1 100); do
  if DISPLAY=:0 xdpyinfo >/dev/null 2>&1; then
    touch "$ready_file"
    wait "$supervisor_pid"
    exit $?
  fi
  if ! kill -0 "$supervisor_pid" >/dev/null 2>&1; then
    wait "$supervisor_pid"
    exit $?
  fi
  sleep 0.05
done

echo "Xvfb did not become ready on DISPLAY=:0" >&2
kill "$supervisor_pid" >/dev/null 2>&1 || true
wait "$supervisor_pid" || true
exit 1
